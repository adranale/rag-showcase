# .env.azure.example

DATABASE_URL=postgresql://USER:PASSWORD@SERVER:5432/rag?sslmode=require

GENERATION_PROVIDER=azure_openai

RAG_API_BASE_URL=https://INTERNAL_API_ADDRESS

# Set by deploy/azure.ps1 as Container Apps secrets; never commit real values.
AZURE_OPENAI_ENDPOINT=https://NAME.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Shared secret between UI and API; API is also internal-only.
API_KEY=
# Password for the Streamlit UI.
APP_PASSWORD=
